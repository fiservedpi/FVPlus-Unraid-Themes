/* Clonarr-inspired dark theme for FolderView Plus
   Based on the working m3.dashboard.css structure */

:root {
  /* Core theme */
  --fvplus-bg:             #0a0f18;
  --fvplus-surface-0:      #0d1420;
  --fvplus-surface-1:      #111a26;
  --fvplus-surface-2:      #162131;
  --fvplus-surface-3:      #1a2638;

  /* Text */
  --fvplus-text:           #e6edf7;
  --fvplus-text-muted:     #95a3b8;
  --fvplus-text-faint:     #6f7f96;

  /* Accent */
  --fvplus-accent:         #2f81f7;
  --fvplus-accent-hover:   #4f97ff;
  --fvplus-accent-active:  #1d68d8;

  /* Borders */
  --fvplus-border:         #253247;
  --fvplus-border-soft:    #1d293b;

  /* Status */
  --fvplus-status-started: #2f81f7;
  --fvplus-status-paused:  #50627d;
  --fvplus-status-stopped: #c94b4b;

  /* Graphs */
  --fvplus-graph-cpu:      #4ea1ff;
  --fvplus-graph-mem:      #7cb8ff;

  /* Compatibility aliases used by older FV+ selectors */
  --fvplus-surface-tint:   var(--fvplus-surface-1);
  --fvplus-hover-bg:       var(--fvplus-surface-3);
  --fvplus-folder-status-started: var(--fvplus-status-started);
  --fvplus-folder-status-paused:  var(--fvplus-status-paused);
  --fvplus-folder-status-stopped: var(--fvplus-status-stopped);

  --folder-view3-graph-cpu: var(--fvplus-graph-cpu);
  --folder-view3-graph-mem: var(--fvplus-graph-mem);
}

/* Main page */
body {
  background:
    linear-gradient(180deg, #0d1420 0%, #0a0f18 100%) !important;
  color: var(--fvplus-text) !important;
}

/* Folder row / folder name cell / update cell / preview */
td.ct-name.folder-name,
td.updatecolumn.folder-update,
div.folder-preview {
  background-color: var(--fvplus-surface-1) !important;
  color: var(--fvplus-text) !important;
  border-color: var(--fvplus-border) !important;
}

/* Make folder rows feel more like dark panels */
tr {
  background-color: transparent !important;
}

tr:hover td.ct-name.folder-name,
tr:hover td.updatecolumn.folder-update,
div.folder-preview:hover {
  background-color: var(--fvplus-surface-3) !important;
  border-color: var(--fvplus-accent) !important;
  transition: background-color 160ms ease, border-color 160ms ease;
}

/* Secondary text */
div.folder-name-sub,
span.state.folder-state,
td.updatecolumn.folder-update,
small,
.muted {
  color: var(--fvplus-text-muted) !important;
}

/* Primary links / labels */
a,
.folder-link,
.folder-title {
  color: var(--fvplus-accent) !important;
}

a:hover,
.folder-link:hover,
.folder-title:hover {
  color: var(--fvplus-accent-hover) !important;
}

/* Graph accents */
.preview-outbox .graph-cpu {
  color: var(--fvplus-graph-cpu) !important;
}

.preview-outbox .graph-mem {
  color: var(--fvplus-graph-mem) !important;
}

/* Buttons / dropdowns */
button.dropDown-open.folder-dropdown,
button.dropDown-open,
button.btn-primary {
  background-color: var(--fvplus-accent) !important;
  color: #ffffff !important;
  border: 1px solid var(--fvplus-accent-active) !important;
  box-shadow: none !important;
}

button.dropDown-open.folder-dropdown:hover,
button.dropDown-open:hover,
button.btn-primary:hover {
  background-color: var(--fvplus-accent-hover) !important;
  border-color: var(--fvplus-accent-hover) !important;
}

button.dropDown-closed.folder-dropdown,
button.dropDown-closed,
button.btn-secondary {
  background-color: var(--fvplus-surface-2) !important;
  color: var(--fvplus-text) !important;
  border: 1px solid var(--fvplus-border) !important;
}

button.dropDown-closed.folder-dropdown:hover,
button.dropDown-closed:hover,
button.btn-secondary:hover {
  background-color: var(--fvplus-surface-3) !important;
  border-color: var(--fvplus-accent) !important;
}

/* Tooltips */
.tooltipster-docker-folder {
  background-color: var(--fvplus-surface-2) !important;
  color: var(--fvplus-text) !important;
  border: 1px solid var(--fvplus-border) !important;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35) !important;
}

/* Generic card/panel helpers often reused in Unraid/FV+ */
.panel,
.card,
.widget,
.box,
.preview-outbox {
  background-color: var(--fvplus-surface-1) !important;
  color: var(--fvplus-text) !important;
  border: 1px solid var(--fvplus-border-soft) !important;
}

/* Inputs */
input,
select,
textarea {
  background-color: var(--fvplus-surface-2) !important;
  color: var(--fvplus-text) !important;
  border: 1px solid var(--fvplus-border) !important;
}

input:focus,
select:focus,
textarea:focus {
  outline: none !important;
  border-color: var(--fvplus-accent) !important;
  box-shadow: 0 0 0 1px var(--fvplus-accent) !important;
}

/* Status coloring */
.started,
.running,
.status-started {
  color: var(--fvplus-status-started) !important;
}

.paused,
.status-paused {
  color: var(--fvplus-status-paused) !important;
}

.stopped,
.status-stopped,
.error {
  color: var(--fvplus-status-stopped) !important;
}
